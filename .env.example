# ══════════════════════════════════════════════════════════
# H2O Studio Sale Album — Environment Variables
# ══════════════════════════════════════════════════════════
# Copy thành .env.local cho dev, hoặc set trong Vercel Dashboard cho prod.
# KHÔNG BAO GIỜ commit file .env.local lên git.
#
# Quy ước:
#   VITE_*  = biến client (nằm trong bundle public) — CHỈ dùng cho giá trị không bí mật
#   không-VITE = biến server-only (api/*.ts, server.ts) — nơi đặt secrets

# ── Supabase ──
# Client (public, lấy trong Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Server-only — Service Role key (bypass RLS, CHỈ dùng trong api/*, KHÔNG có prefix VITE)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── AI ──
# Server-only — Gemini API key cho các endpoint /api/* (live-chat-bot, embed, vector-synthesis)
GEMINI_API_KEY=<gemini-api-key>

# ── Cron ──
# Secret dùng xác thực Vercel Cron → /api/cron-*. Bắt buộc trong prod (fail-closed nếu thiếu).
CRON_SECRET=<random-long-secret>

# ── Notifications (server-only) ──
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_CHAT_ID=<telegram-chat-id>
LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/<id>
LARK_KEYWORD=<lark-keyword-if-configured>

# ── R2 Upload Worker (server-only) ──
# Worker secret — client KHÔNG biết. api/r2-upload.ts gọi Worker kèm secret này.
R2_WORKER_URL=https://<worker>.workers.dev
R2_UPLOAD_SECRET=<worker-shared-secret>

# ── Misc ──
# URL production của site (dùng cho sitemap, OG links, CORS nếu cần)
APP_URL=https://<domain>

# Google Apps Script endpoint cho Drive upload fallback + Sheets lead sync (public URL nhưng là write-only endpoint)
VITE_GOOGLE_SCRIPT_URL=

# Bootstrap fallback: email admin đầu tiên (chỉ dùng khi user_roles trống)
VITE_ADMIN_EMAIL=
